+// --- repro profiling (only when REPRO_PROF_DIR is set) ---
+// vi.mock() in browser mode registers one `context.route(predicate)` per mocked module.
+// Once any route exists, Playwright intercepts *every* request of that browser context and
+// evaluates every registered predicate for it on the Node main thread. This counts that work
+// (playwright-<pid>.json).
+let __reproRouteProf;
+function __reproRoutes() {
+	if (__reproRouteProf) return __reproRouteProf;
+	const st = { registers: 0, registersByType: {}, predicateCalls: 0, predicateMatched: 0, predicateMs: 0, handlerCalls: 0, ops: {} };
+	process.once("exit", () => {
+		__reproMkdir(process.env.REPRO_PROF_DIR, { recursive: true });
+		__reproWrite(__reproJoin(process.env.REPRO_PROF_DIR, `playwright-${process.pid}.json`), JSON.stringify({ ...st, predicateMs: Math.round(st.predicateMs) }, null, 1));
+	});
+	return __reproRouteProf = {
+		predicate(ms, matched) {
+			st.predicateCalls++;
+			st.predicateMs += ms;
+			if (matched) st.predicateMatched++;
+		},
+		register(type) {
+			st.registers++;
+			st.registersByType[type] = (st.registersByType[type] || 0) + 1;
+		},
+		handler() {
+			st.handlerCalls++;
+		},
+		op(name, ms) {
+			const o = st.ops[name] ??= { n: 0, totalMs: 0, maxMs: 0 };
+			o.n++;
+			o.totalMs = Math.round(o.totalMs + ms);
+			if (ms > o.maxMs) o.maxMs = Math.round(ms);
+		}
+	};
+}
 
