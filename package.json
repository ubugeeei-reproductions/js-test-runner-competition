{
  "name": "js-test-runner-competition",
  "private": true,
  "type": "module",
  "imports": {
    "#host": {
      "types": "./host/types.ts",
      "bun": "./host/bun/host.ts",
      "deno": "./host/deno/host.ts",
      "repro-node": "./host/node/host.ts",
      "repro-uf": "./host/uf/host.ts",
      "default": "./host/types.ts"
    },
    "#src/*": "./fixture/src/*.ts"
  },
  "scripts": {
    "bench": "node scripts/bench.ts",
    "generate": "node --disable-warning=ExperimentalWarning scripts/generate.ts",
    "typecheck": "node --disable-warning=ExperimentalWarning scripts/generate.ts && tsc -p tsconfig.json",
    "postinstall": "node --disable-warning=ExperimentalWarning scripts/generate.ts"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
