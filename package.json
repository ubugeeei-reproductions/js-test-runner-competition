    "@happy-dom/jest-environment": "20.14.6",
    "@jest/globals": "30.5.2",
    "@rstest/browser": "0.12.3",
    "@rstest/core": "0.12.3",
    "@std/expect": "jsr:^1",
    "@std/testing": "jsr:^1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@uniflowed/host": "0.36.0",
    "@uniflowed/test": "0.36.0",
    "@vitest/browser-playwright": "5.0.3",
    "babel-jest": "30.5.2",
    "expect": "30.5.2",
    "happy-dom": "20.14.6",
    "jest": "30.5.2",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
